# ~/.zshrc: executed by zsh for interactive shells.
# Managed by shell-prompt-setup. Machine- or user-specific bits (ssh-agent, PROMPT_VIP, ...)
# go in ~/.zshrc.local, which is sourced below and never overwritten by the installer.

# History: large, shared between sessions, no duplicates.
# Commands starting with a space are not saved.
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history extended_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks

setopt interactive_comments   # allow "# comments" on the command line
setopt no_beep

# Homebrew (macOS): puts brew and its tools on PATH.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x $_brew ]]; then eval "$($_brew shellenv)"; break; fi
done
unset _brew

# Completion: menu you can arrow through; case-insensitive, then fragments of a name
# (docker-comp<Tab> -> docker-compose.yaml).
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Colors for ls and completion. GNU dircolors/ls (Linux, or coreutils on macOS) if present,
# otherwise BSD ls colors (macOS).
if (( $+commands[dircolors] )); then _dircolors=dircolors; _gnuls=ls
elif (( $+commands[gdircolors] )); then _dircolors=gdircolors; _gnuls=gls
fi
if [[ -n $_dircolors ]]; then
  eval "$($_dircolors)"
  zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
  alias ls="$_gnuls --color=auto"
  alias ll="$_gnuls --color=auto -l"
  alias l="$_gnuls --color=auto -lA"
else
  export CLICOLOR=1
  alias ls='ls -G'
  alias ll='ls -G -l'
  alias l='ls -G -lA'
fi
unset _dircolors _gnuls

# Emacs-style keys (like bash); Up/Down search history for what's already typed
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# User scripts
export PATH="$HOME/.local/bin:$PATH"

# Per-machine / per-user additions (ssh-agent, PROMPT_VIP, aliases, ...)
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local

# Corners are rounded by default. Some fonts (a browser SSH terminal, say) draw rounded corners
# unevenly, so square ones are used when PROMPT_CORNERS=square, or for an ssh session whose
# client address is in PROMPT_SQUARE_FROM (space-separated; set both in ~/.zshrc.local).
if [[ ${PROMPT_CORNERS:-} == square ]] ||
   [[ -n ${SSH_CONNECTION:-} && -n ${PROMPT_SQUARE_FROM:-} && " $PROMPT_SQUARE_FROM " == *" ${SSH_CONNECTION%% *} "* ]]; then
  export PROMPT_CORNER_TOP='┌─' PROMPT_CORNER_BOTTOM='└─'
fi

# ssh hops: the ssh function below sends a hop counter (LC_PROMPT_HOPS; sshd accepts LC_*), so a
# session started from another ssh session knows its depth. Label: ssh, ssh2, ssh3, ... A session that
# arrives without a counter (a browser terminal, scp, a script) counts as one hop.
if [[ -n ${SSH_CONNECTION:-} ]]; then
  [[ ${LC_PROMPT_HOPS:-} == <-> ]] && export PROMPT_HOPS=$LC_PROMPT_HOPS || export PROMPT_HOPS=1
  (( PROMPT_HOPS > 1 )) && export PROMPT_SSH_LABEL="ssh$PROMPT_HOPS" || export PROMPT_SSH_LABEL=ssh
fi
ssh() { LC_PROMPT_HOPS=$(( ${PROMPT_HOPS:-0} + 1 )) command ssh -o SendEnv=LC_PROMPT_HOPS "$@"; }

# In an ssh session use the orange-frame variant of the prompt config (install.sh generates
# ~/.config/starship-ssh.toml from starship.toml), so a remote host is obvious at a glance.
if [[ -n ${SSH_CONNECTION:-} && -r ~/.config/starship-ssh.toml ]]; then
  export STARSHIP_CONFIG=~/.config/starship-ssh.toml
fi

# Prompt (config: ~/.config/starship.toml)
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Plugins (Debian/Ubuntu: /usr/share, Homebrew: $(brew --prefix)/share). Syntax highlighting last.
# Ghost-text suggestions: from history first, then from real files/folders (completion).
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
for _d in /usr/share /opt/homebrew/share /usr/local/share /home/linuxbrew/.linuxbrew/share; do
  [[ -r $_d/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && { source $_d/zsh-autosuggestions/zsh-autosuggestions.zsh; break; }
done
for _d in /usr/share /opt/homebrew/share /usr/local/share /home/linuxbrew/.linuxbrew/share; do
  [[ -r $_d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && { source $_d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; break; }
done
unset _d

# The default blue for globs (*, ?) and history expansion (!!) is unreadable on dark backgrounds.
(( ${+ZSH_HIGHLIGHT_STYLES} )) && {
  ZSH_HIGHLIGHT_STYLES[globbing]='fg=cyan,bold'
  ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=cyan,bold'
}
